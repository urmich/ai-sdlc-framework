{
  "name": "ai-sdlc-framework",
  "version": "0.4.0",
  "description": "Offline, receipt-bound SDLC workflow for GitHub Copilot CLI",
  "author": "urmich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urmich/ai-sdlc-framework.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sdlc": "./bin/sdlc.mjs"
  },
  "scripts": {
    "test": "node scripts/test-runner.mjs full",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:critical": "node scripts/test-runner.mjs critical",
    "test:targeted": "node scripts/test-runner.mjs targeted",
    "test:full": "node scripts/test-runner.mjs full",
    "test:coverage": "node scripts/test-runner.mjs coverage",
    "check": "node scripts/check.mjs",
    "package:artifact": "node scripts/package.mjs",
    "package:platforms": "node scripts/package-platforms.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:platforms": "node scripts/verify-platform-package.mjs",
    "test:distribution": "node --test test/distribution-channels.test.mjs",
    "doctor": "node bin/sdlc.mjs doctor",
    "install:copilot": "node bin/sdlc.mjs install",
    "uninstall:copilot": "node bin/sdlc.mjs uninstall"
  },
  "exports": {
    "./cli": "./src/cli.mjs",
    "./operations": "./src/operations.mjs",
    "./pr": "./src/pr.mjs",
    "./provider-adapters": "./src/provider-adapters.mjs",
    "./monitors": "./src/monitors.mjs",
    "./store": "./src/store.mjs",
    "./evidence": "./src/evidence.mjs",
    "./github": "./src/github.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "packaging/standalone",
    "README.md",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "OWNERSHIP.md",
    "RELEASING.md",
    "CHANGELOG.md",
    "docs"
  ]
}
