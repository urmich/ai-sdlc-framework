{
  "name": "ai-sdlc-framework",
  "version": "0.3.0",
  "description": "Offline, receipt-bound SDLC workflow for GitHub Copilot CLI",
  "author": "Michael Urinovsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urmich/ai-sdlc-framework.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "sdlc": "./bin/sdlc.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package:artifact": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "doctor": "node bin/sdlc.mjs doctor",
    "install:copilot": "node bin/sdlc.mjs install",
    "uninstall:copilot": "node bin/sdlc.mjs uninstall"
  },
  "exports": {
    "./provider-adapters": "./src/provider-adapters.mjs",
    "./monitors": "./src/monitors.mjs",
    "./store": "./src/store.mjs"
  },
  "files": ["bin", "src", "assets", "README.md", "docs/cli.md",
    "docs/provider-adapters.md", "docs/ado-acceptance-test.md"]
}
